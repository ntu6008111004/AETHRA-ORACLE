# AETHRA reads these values only on the local server. Never put the key in browser JavaScript.
THAILLM_API_KEY=replace-with-your-thaillm-key
THAILLM_API_URL=https://thaillm.or.th/api/v1/chat/completions
THAILLM_MODEL=qwen3.6-35b-a3b

# Optional: point to another env file containing the same owner-provided key.
# AETHRA_SHARED_ENV_FILE=D:\path\to\shared\.env
